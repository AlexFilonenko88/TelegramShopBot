# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=0000000000:REPLACE_WITH_REAL_BOT_TOKEN
# Список Telegram ID администраторов через запятую
ADMIN_IDS=111111111,222222222

# --- База данных ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop_bot
DB_USER=shop_bot
DB_PASSWORD=change-me
# Пароль контейнера postgres (docker-compose)
POSTGRES_PASSWORD=change-me

# --- YooKassa ---
YOOKASSA_SHOP_ID=replace-with-shop-id
YOOKASSA_SECRET_KEY=replace-with-secret-key
# Базовый HTTPS-URL для webhook-платежей
PUBLIC_BASE_URL=https://example.com

# --- Приложение ---
# development | production
ENVIRONMENT=development
# ru | en — язык сообщений по умолчанию
DEFAULT_LANGUAGE=ru
# ru | en | all
BOT_LANGUAGE_MODE=ru
# Лог-уровень: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
